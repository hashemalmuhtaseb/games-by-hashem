{
  "name": "partyverse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --ignore ./.next server.ts",
    "build": "next build",
    "start": "NODE_ENV=production tsx server.ts",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "postinstall": "prisma generate",
    "make-admin": "tsx scripts/make-admin.ts",
    "start:railway": "prisma db push --skip-generate && NODE_ENV=production tsx server.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "an-array-of-english-words": "^2.0.0",
    "bcryptjs": "^3.0.2",
    "canvas-confetti": "^1.9.3",
    "country-flag-icons": "^1.5.19",
    "framer-motion": "12.23.12",
    "motion-dom": "12.23.12",
    "motion-utils": "12.23.6",
    "next": "^15.5.27",
    "prisma": "^6.19.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sharp": "^0.34.3",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.20.5",
    "world-countries": "^5.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
