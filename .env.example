# Required
DATABASE_URL="postgresql://party:party@localhost:5432/partyverse"
# Secret used to sign guest cookies. Generate with: openssl rand -hex 32
SESSION_SECRET="change-me"

# Optional: username that is promoted to ADMIN when it registers (or run `npm run make-admin -- <username>`).
ADMIN_USERNAME=""

# Optional AI provider for the AI Game Master and question generation.
# Without these the platform uses the built-in non-AI host and dataset generators.
AI_PROVIDER=""            # "anthropic" | "openai-compatible"
AI_API_KEY=""
AI_MODEL=""               # e.g. claude-sonnet-5-5
AI_BASE_URL=""            # for openai-compatible providers (Ollama, OpenRouter, etc.)

# Rooms, timers and rate limits live in one Node process. Run a single instance (Redis-backed
# multi-instance scaling is not implemented yet; see docs/CHECKLIST.md).

# Optional: iTunes Search API previews for Guess the Song audio (no key required, but it is an external service).
ENABLE_ITUNES_PREVIEWS="0"   # set to 1 to enable
